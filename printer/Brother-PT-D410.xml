<printer id="printer/Brother-PT-D410">
  <make>Brother</make>
  <model>PT-D410</model>
  <pcmodel>D410</pcmodel>
  <mechanism>
    <thermal/>
    <!--not "color"-->
    <resolution>
      <dpi>
        <x>180</x>
        <y>180</y>
      </dpi>
    </resolution>
  </mechanism>
  <url>https://www.brother.com.au/en/products/all-labellers/labellers/pt-p710bt</url>
  <url>https://www.brother.com.au/en/products/all-labellers/labellers/pt-d410</url>
  <lang>
    <proprietary />
  </lang>
  <autodetect>
    <general>
      <ieee1284>MFG:Brother;CMD:PT-CBP;MDL:PT-D410;CLS:PRINTER;</ieee1284>
      <commandset>PT-CBP</commandset>
      <description>Brother PT-D410</description>
      <manufacturer>Brother</manufacturer>
      <model>PT-D410</model>
    </general>
  </autodetect>
  <functionality>D</functionality>
  <driver>ptouch-pt</driver>
  <!--no "contrib_url"-->
  <comments>
    <en>
    Print durable, colourful labels up to 12mm in width.
    AC adapter; Input 120V Output 5V
    Replacable batteries (Double AA * 6)
    Tape width 12mm.
    Prints 20mm per second.
    Automatic cutter.
    Print via USB.
    </en>
  </comments>
  <select>
    <option id="opt/Brother-PTQL-TransferMode" />
    <option id="opt/Brother-PTQL-Resolution">
      <enum_val id="ev/180dpi" />
    </option>
    <option id="opt/Brother-PTQL-BytesPerLine">
      <enum_val id="ev/16" />
    </option>
    <option id="opt/Brother-PTQL-LabelPreamble" />
    <option id="opt/Brother-PT-LabelRecovery" />
    <option id="opt/Brother-PT-PageSize">
      <arg_defval>ev/tz-24</arg_defval>
      <enum_val id="ev/tz-12" />
    </option>
    <option id="opt/Brother-PTQL-PixelTransfer">
      <enum_val id="ev/RLE" sense="false" />
    </option>
    <option id="opt/Brother-PTQL-AutoCut" />
  </select>
</printer>
